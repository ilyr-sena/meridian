[Unit]
Description=Meridian Control Center Next.js Web App
After=network.target mongod.service

[Service]
Type=simple
User=admin
WorkingDirectory=/home/admin/meridian/apps/web
ExecStart=/usr/bin/npm run start -- -p 3000
Restart=always
RestartSec=5
Environment=NODE_ENV=production
Environment=PORT=3000

[Install]
WantedBy=multi-user.target
